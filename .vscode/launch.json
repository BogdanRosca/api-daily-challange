{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
        "name": "Debug pytest: current file",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": ["${file}", "-s", "-vv"],
        "cwd": "${workspaceFolder}",
        "justMyCode": false,
        "console": "integratedTerminal"
        },
        {
        "name": "Debug pytest: by -k / marker",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": ["-m", "meters", "-k", "${input:testFilter}", "-s", "-vv"],
        "cwd": "${workspaceFolder}",
        "justMyCode": false
        }
    ],
    "inputs": [
        { "id": "testFilter", "type": "promptString", "description": "pytest -k expression" }
    ]
}